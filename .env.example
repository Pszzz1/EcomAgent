APP_ENV=local

# DashScope OpenAI-compatible API
LLM_PROVIDER=dashscope
# Intent decisions, copy generation and revision
LLM_WORK_MODEL=qwen3-max
# Independent compliance review and product image understanding
LLM_REVIEW_MODEL=qwen3-max
# Promotion image creation
IMAGE_GENERATION_MODEL=qwen-image-2.0-pro
# Structured Agent calls normally do not benefit from Qwen3's long thinking mode.
LLM_ENABLE_THINKING=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_TIMEOUT_SECONDS=100

# Local task persistence.
TASK_DB_PATH=data/release_tasks.sqlite3
IMAGE_ASSET_PATH=data/assets

# React development server origins. Production uses the same FastAPI origin.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
